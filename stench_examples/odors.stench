

dump "f" ;
odor dump_and_return(smell: string, other: num) num {
    dump smell;
    dump other;
    dump smell;
    pileup i=0;i<10;i=i+1{
        dump i;
    }
    other
};
odor dump_and_no_return(smell: string, other: num) {
    dump smell;
    dump other;
    dump smell;
    pileup i=0;i<10;i=i+1{
        dump i;
        if i is other { 
            break;
        }
    }
};

x = sniff dump_and_return("x", 5);
y = sniff dump_and_no_return("x",5 );
dump ("x is " + x);
dump ("y is " + y);
