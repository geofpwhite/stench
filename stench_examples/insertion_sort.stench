list = [5,2,8,34,7,3];
odor insertionSort(list: bucket) bucket {
    pileup i := list { 
        pileup j=_index_;j>0 and (list[j]<list[j-1]);j=j-1 {
            hold = list[j];
            list[j]=list[j-1];
            list[j-1]=hold;
        }
    }
    list
}

ary = sniff insertionSort(list);
dump list;
dump ary;
